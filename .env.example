# Existing services (runtime secrets)
OPENAI_API_KEY=
PINECONE_API_KEY=
DASHBOARD_API_KEY=

# Off until model access, persistence and calibration are verified.
CLASSIFICATION_AB_ENABLED=false
CLASSIFICATION_AB_TREATMENT_PERCENT=50
CLASSIFICATION_AB_EXPERIMENT_ID=clef-flash-v1
OPENROUTER_API_KEY=
OPENROUTER_DECISION_MODEL=cloudflare/clef-flash
# Pin Prime Intellect: Cloudflare Workers AI documents ~2K text-state truncation.
OPENROUTER_DECISION_PROVIDER=primeintellect
OPENROUTER_SUMMARY_MODEL=openai/gpt-5-nano
# Generate once; keep stable across restarts. Never commit the actual value.
AB_COHORT_HMAC_KEY=
AB_CATEGORY_MIN_PROBABILITY=0.95
AB_NOUL_THRESHOLD=0.5
# Local defaults; Coolify runtime values: /app/data/ab and /app/reports
AB_DATA_DIR=data/ab
AB_REPORT_DIR=reports
